        }
      }
    },
    "!!willpower vs a billion-dollar algorithm?!!": {
      "localizations": {
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "!!força de vontade contra um algoritmo de mil milhões?!!"
          }
        }
      }
    },
    "%@ can't block apps without Screen Time access. You can continue and connect it later from the app.": {
      "localizations": {
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A %@ não consegue bloquear apps sem acesso ao Tempo de ecrã. Podes continuar e ligá-lo mais tarde na app."
          }
        }
      }
    },
    "%@ does not collect your Screen Time usage.": {
      "localizations": {
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A %@ não recolhe a tua utilização do Tempo de ecrã."
          }
        }
      }
    },
    "%@ doesn't have Screen Time permission, so your apps aren't locked right now.": {
      "localizations": {
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A %@ não tem autorização do Tempo de ecrã, por isso as tuas apps não estão bloqueadas agora."
          }
        }
      }
    },
    "%@ every %lld %@": {
      "localizations": {
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ a cada %2$lld %3$@"
          }
        }
      }
    },
    "%@ has no accounts. Your subscription is tied to your Apple ID (use Restore Purchases on a new phone). Progress syncs with your iCloud.": {
      "localizations": {
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A %@ não tem contas. A tua subscrição está associada à tua conta Apple (usa Restaurar compras num telemóvel novo). O progresso sincroniza com o teu iCloud."
          }
        }
      }
    },
    "%@ is active. Thank you!": {
      "localizations": {
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O %@ está ativo. Obrigado!"
          }
        }
      }
    },
    "%@ is locked by %@.\nTap START PUZZLE, then open %@.": {
      "localizations": {
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ está bloqueada pela %2$@.\nToca em INICIAR PUZZLE e depois abre a %3$@."
          }
        }
      }
    },
    "%@ is made by a tiny team. If you like it so far, a rating helps other people find it.": {
      "localizations": {
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A %@ é feita por uma equipa pequenina. Se estás a gostar, uma avaliação ajuda outras pessoas a encontrá-la."
          }
        }
      }
    },
    "%@ is now %@. Good luck!": {
      "localizations": {
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ está agora em %2$@. Boa sorte!"
